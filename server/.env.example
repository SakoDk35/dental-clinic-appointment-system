# server/.env.example
# Copy this to .env and fill in your real local PostgreSQL connection string.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dental_clinic?schema=public"
PORT=4000

# Used to sign/verify login tokens (Step 2 - Authentication).
# Use any long random string locally; use a real secret in production.
JWT_SECRET="replace-with-a-long-random-string"
